# GIMP tool preset file

(icon-name "gimp-tool-paintbrush")
(icon-pixbuf "")
(name "NoitaBrush")
(tool-options "GimpPaintOptions"
    (tool "gimp-paintbrush-tool")
    (foreground
        (color "HSVA float" 16 "\0\0\0\0\0\0\200\77\0\0\200\77\0\0\200\77" 0))
    (background
        (color "R'G'B'A u8" 4 "\306\250\317\377" 0))
    (brush "1. Pixel")
    (dynamics "Pressure Size")
    (pattern "Marble #1")
    (gradient "Skyline")
    (palette "Standard")
    (brush-size 31)
    (brush-spacing 0.20000000000000001)
    (brush-force 1))
(use-fg-bg yes)
(use-opacity-paint-mode yes)
(use-brush yes)
(use-dynamics yes)
(use-mypaint-brush no)
(use-gradient no)
(use-pattern yes)
(use-palette no)
(use-font no)

# end of GIMP tool preset file
